//------------------------------------------------------------------------------------------
GetClickedState( int btn )
{
    int ret = -1;
    //
    if( btn && !gbMsgDlg)
    {
        if( btn == MenuFindNamed( "GOTO_CAMPAIGN" ) )
		{
        	if(!MOD_BASE_DISABLE || ALLOW_SINGLEPLAYER_MODE)
	            ret = MENU_PERKSCREEN;
			else
	            CreateTip(TIP_DEMOVERSION);
			
			Exec("Gamedata\\db\\player.exe");
		}
        else
        if( btn == MenuFindNamed( "GOTO_OPTIONS" ) )
            ret = MENU_OPTIONS;
        else
        if( btn == MenuFindNamed( "GOTO_CREDITS" ) )
            ret = MENU_CREDITS;
        else
        if( btn == MenuFindNamed( "GOTO_EXIT" ) )
            //ret = MENU_EXIT; // ��� �������������, ������ ����������� ������
			ShowMessageDlg(MD_EXIT, "Confirm_Exit");
			//Exec("Gamedata\\db\\phb.exe"); // phb.exe - 预留			
        else
        if( btn == MenuFindNamed( "GOTO_PROFSEL" ) )
            ret = MENU_PROFILESEL;
        else
        if( btn == MenuFindNamed( "GOTO_MULTIPLAYER" ) )
        {
        	if(!Z_DEMO_VER || Z_ALLOW_MULTIPLAYER_INDEMO)
	            ret = MENU_MULTIPLAYER;
			else
	            CreateTip(TIP_NOTINDEMO);
		}
        else
        if( btn == MenuFindNamed( "GOTO_SURVIVE" ) )
		{
        	if(!MOD_BASE_DISABLE || ALLOW_SURVIVE_BUTTON)
	            ret = MENU_SURVIVE;
			else
	            CreateTip(TIP_NOTINBETA);
		}
        else
		if( btn == MenuFindNamed( "GOTO_SURVIVE_DLC" ) )
		{
        	if(!MOD_BASE_DISABLE || ALLOW_SURVIVE_BUTTON)
	            ret = MENU_SURVIVE_DLC;
			else
	            CreateTip(TIP_NOTINBETA);
		}
        else
        if( btn == MenuFindNamed( "GOTO_HALLOFFAME" ) )
            ret = MENU_FAME;
		else
		if( btn == MenuFindNamed( "GOTO_PATCHNOTES" ) )
            ret = MENU_PATCHNOTES;
		
    }
    //
    return ret;
}


//------------------------------------------------------------------------------------------
ShowEditedName()
{
    if( !EditedName )
        EditedName = MenuFindNamed( "PERK_PlayerName" );
    //
    string text = GetCurUserName();
    //
    if( EnterNameOn )
    {
        //process blinking
        if( GetTime() - LastBlinkTime < 500 )
            text += "_";
        else
        if( GetTime() - LastBlinkTime < 900 )
            ;
        else
            LastBlinkTime = GetTime();
    }
    //
    if( EditedName )
        Action( EditedName, ACT_SET_TEXT, &text );
}


//------------------------------------------------------------------------------------------
static bool gbNewGameMen = false;
//���������� true, ���� ����� ��� �����
ProcessNewGame()
{
    int iCurProf = SendCommand(EXT_GetCurProf);
    int iMaxLevNum = SendCommand(EXT_GetMaxLevNum, iCurProf, 0);
    //���������, ����� ����� ��� �����
    if(!gbNewGameMen && iMaxLevNum <= Z_FIRST_LEVEL_NUM )
        return false;
    //
    if(!gbNewGameMen )
    {
        //
        MenuLoad("gamedata\\men\\continue.men");
        gbNewGameMen = true;
        //
        ShowCharScreen( CS_SHOPSMALL, true );
        //
        ContinueMenTact(true);
    }
    else
    {
    	ContinueMenTact(false);
    	//
        bool bRelease = false;
        if( MenuLClick() == MenuFindNamed( "NGAME_CLOSE" ) || GetKey() == VK_ESCAPE)
            bRelease = true;
        else
        if( MenuLClick() == MenuFindNamed( "NGAME_NEW" ) )
        {
            ShowMessageDlg(MD_NEWGAME, "Confirm_NewGame2","Confirm_NewGame1","Confirm_NewGame3");
        }
        else
        if( MenuLClick() == MenuFindNamed( "NGAME_CONTINUE" ) || GetKey() == VK_RETURN)
        {
            Pause(0);
            if( CM_GetSelLevel() > 0 )
	            GoFromMapWithFade( GetLevelName(CM_GetSelLevel(), false) );
        }
        //
        if(bRelease)
        {
            MenuRelease("gamedata\\men\\continue.men");
            int spr = MenuFind(725);
            if(spr)
            	Destroy(spr);
            gbNewGameMen = false;
            ShowCharScreen( CS_SHOPSMALL, false );
        }
    }
    return true;
}


static int saMMBtnTimes[8] = {0, 0, 0, 0, 0, 0, 0, 0};
//------------------------------------------------------------------------------------------
F793_14(int unit)
{
	if(!gbCanAnimateBtns)
		return;
	//
	int dd = 0;
    int i;
	for(i = 0; i < 8; i++)
	{
		int spr = GetSprByVid(3730+i);
		if(spr)
		{
			saMMBtnTimes[i] = GetTime() + dd;
			dd += 100;
		}
	}
	gbCanAnimateBtns = false;
}


//------------------------------------------------------------------------------------------
MMButtonsTact()
{
	if(gbMustCreate792 && MenuStateMM != MENU_PROFILECREATE)
	{
		CreateSprite(792, g_792_X, g_792_Y, g_792_Z);
		gbMustCreate792 = false;
		return;
	}
	//
	int i;
	for(i = 0; i < 8; i++)
	{
		if(saMMBtnTimes[i] && GetTime() >= saMMBtnTimes[i])
		{
			saMMBtnTimes[i] = 0;
			int spr = GetSprByVid(3730+i);
			Action(spr, ACT_SET_INVISIBLE, 0);
			Action(spr, ANI_BIRTH);
		}
	}
}

// romalu86 - Random menu backgrounds
static int Random_Menu_Backgrounds[] = {3900, 3901, 3902, 3903};

RandomizeMenu(int unit)
{
	int cnt = sizeof(Random_Menu_Backgrounds)/4;
	int r = Random_(cnt-1);
	if( GetVidData(Random_Menu_Backgrounds[r], VID_EXIST))
		Action(unit, ACT_CHANGE_VID, Random_Menu_Backgrounds[r]);
}

// ������ ��� ����� ��� �����������.
F704_14(int unit) 
{
	RandomizeMenu(unit);
}

