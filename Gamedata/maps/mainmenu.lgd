//------------------------------------------------------------------------------------------
ChangeMenuState( int new_menu_type )
{
    PrevMenuStateMM = MenuStateMM;
    MenuStateMM = new_menu_type;
    //
    Effect( EFF_FADE, 0, 0, FADE_GAME_TIME );
    StartEffectTime = GetTime();
    //LoadMapName = "gamedata\\scripts\\shop.map";
}


//------------------------------------------------------------------------------------------
//return true if mouse was cliked in the "enter profil name" area
MouseWasClikedToEnterTheName()
{
    int x, y, center_x, center_y;

    x = GetInputAction(IA_SCREEN_MOUSE_X);
    y = GetInputAction(IA_SCREEN_MOUSE_Y);

    center_x = ScreenX() / 2;
    center_y = ScreenY() / 2;

    center_y -= 100;

    int left, top, right, bottom;
    left    = center_x - 170;
    right   = center_x + 170;
    top     = center_y - 17;
    bottom  = center_y + 17;

    int ret = 0;

    if( x >= left && x <= right && y >= top && y <= bottom )
        ret = 1;

    return ret;
}


