  iff(1)
  {
    SetMapTypeEx( MAP_TYPE_LEVEL, "Level_01" );
    InitGame();
  // 初始化传送系统 想在哪关使用就加这一天
    
  // 例如：输入K Z L  (就是卡住了)
    
  //玩家会自我伤害？点，然后传送到鼠标距离-50单位的距离
    
  //InitTeleportSystem();  
    //SetScrollBoxEx( 0 );
  }
  if( GameTact() )
    return;

  QuestsTact();
  CompaignGameTact();
// 更新传送系统
  UpdateTeleportSystem();
 
    //磬 磬鬣腩 赈羼蜞 1_53
    iff( SendCommand( EXT_GETQUESTSSTATE, 0, 53, 1 ) & QS_BEGUN )
    {// 蜞殪屦 磬 镳钼嚯 扈耨梃
        FailureMissionStartTime = GetTime();
    }
    if ( FailureMissionStartTime )
    {
        int sec = FAILURE_COUNTER - (GetTime() - FailureMissionStartTime) / 1000;
        if ( sec <= 0 )
        {
            FailureMissionStartTime = 0;
            Destroy(FailureMissionCounter); FailureMissionCounter = 0;
            GameState = GAME_MISSION_FAILED;
            Effect( EFF_NUKE, 0xffffff, 0, 3000 );
            PlaySFX(40);
            EarthQuake(4000);
        }
        else if ( sec != FailureMissionPrevCounterSec )
        {
            FailureMissionPrevCounterSec = sec;
            string str = itoa(sec / 60) + ":";
            if ( (sec % 60) < 10 )
                str += "0";
            str += itoa(sec % 60);
            if ( !FailureMissionCounter )
                FailureMissionCounter = CreateText( 14, ScreenX() / 2, MISSION_FAILURE_COUNTER_Y, 0, str, BEH_CENTER );
            else
                Action(FailureMissionCounter, ACT_SET_TEXT, &str);
        }
    }
    //磬 磬鬣腩 赈羼蜞 1_54
    iff( SendCommand( EXT_GETQUESTSSTATE, 0, 54, 1 ) & QS_BEGUN )
    {
        FailureMissionStartTime = 0;
        Destroy(FailureMissionCounter); FailureMissionCounter = 0;
 }
     
