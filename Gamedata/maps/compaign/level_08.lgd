SetVidData(2380,VID_BATTLERANGE,480);
SetVidData(2380,VID_AIM_RADIUS,10);

SetVidData(2390,VID_BATTLERANGE,640);
SetVidData(2390,VID_AIM_RADIUS,10);

SetVidData(2404,VID_BATTLERANGE,480);
SetVidData(2404,VID_AIM_RADIUS,10);

SetVidData(2416,VID_BATTLERANGE,480);
SetVidData(2416,VID_AIM_RADIUS,10);

SetVidData(2430,VID_BATTLERANGE,480);
SetVidData(2430,VID_AIM_RADIUS,10);

SetVidData(1840,VID_BATTLERANGE,480);
SetVidData(1840,VID_AIM_RADIUS,10);

SetVidData(3001,VID_RELOAD_TIME,1);
SetVidData(3001,VID_AIM_RADIUS,20);
SetVidData(3006,VID_DAMAGE_MIN,720);
SetVidData(3006,VID_DAMAGE_MAX,800);
SetVidData(3006,VID_DEATHRANGE,120);
SetVidData(3011,VID_RELOAD_TIME,10);
SetVidData(3011,VID_AIM_RADIUS,20);
  iff(1)
  {
    SetMapTypeEx( MAP_TYPE_LEVEL, "Level_01" );
    InitGame();
  // іхКј»Їґ«ЛНПµНі ПлФЪДД№ШК№УГѕНјУХвТ»Мм
    
  // АэИзЈєКдИлK Z L  (ѕНКЗїЁЧЎБЛ)
    
  //НжјТ»бЧФОТЙЛє¦ЈїµгЈ¬И»єуґ«ЛНµЅКу±кѕаАл-50µҐО»µДѕаАл
    
  //InitTeleportSystem();  
    //SetScrollBoxEx( 0 );
  }
  if( GameTact() )
    return;

  QuestsTact();
  CompaignGameTact();
  // ёьРВґ«ЛНПµНі
  UpdateTeleportSystem();
 
    //на начало квеста 1_53
    iff( SendCommand( EXT_GETQUESTSSTATE, 0, 53, 1 ) & QS_BEGUN )
    {// таймер на провал миссии
        FailureMissionStartTime = GetTime();
    }
    if ( FailureMissionStartTime )
    {
        int sec = FAILURE_COUNTER - (GetTime() - FailureMissionStartTime) / 1000;
        if ( sec <= 0 )
        {
            FailureMissionStartTime = 0;
            Destroy(FailureMissionCounter); FailureMissionCounter = 0;
            GameState = GAME_MISSION_FAILED;
            Effect( EFF_NUKE, 0xffffff, 0, 3000 );
            PlaySFX(40);
            EarthQuake(4000);
        }
        else if ( sec != FailureMissionPrevCounterSec )
        {
            FailureMissionPrevCounterSec = sec;
            string str = itoa(sec / 60) + ":";
            if ( (sec % 60) < 10 )
                str += "0";
            str += itoa(sec % 60);
            if ( !FailureMissionCounter )
                FailureMissionCounter = CreateText( 14, ScreenX() / 2, MISSION_FAILURE_COUNTER_Y, 0, str, BEH_CENTER );
            else
                Action(FailureMissionCounter, ACT_SET_TEXT, &str);
        }
    }
    //на начало квеста 1_54
    iff( SendCommand( EXT_GETQUESTSSTATE, 0, 54, 1 ) & QS_BEGUN )
    {
        FailureMissionStartTime = 0;
        Destroy(FailureMissionCounter); FailureMissionCounter = 0;
 }
     
           //iff( SizeTo(Flagman(0),2301,362) < 70 )
