SetVidData(1161,VID_DETECTRANGE,640);
SetVidData(1161,VID_AIM_RADIUS,20);
SetVidData(1404,VID_DAMAGE_MIN,160);
SetVidData(1404,VID_DAMAGE_MAX,160);
SetVidData(1404,VID_DEATHRANGE,40);

SetVidData(2088,VID_BATTLERANGE,580);
SetVidData(2090,VID_BATTLERANGE,580);
