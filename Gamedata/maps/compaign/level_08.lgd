#include "gamedata\maps\compaign\tlks.lgc"

#define FAILURE_COUNTER           720 // время
#define MISSION_FAILURE_COUNTER_Y 160  // высота на которо?рисется счетчи?времен?

static int EndQuest = 0;
static int FailureMissionStartTime = 0;
static int FailureMissionCounter = 0;
static int FailureMissionPrevCounterSec = 0;

main()
{
SetVidData(2042,VID_MAXHP,132000);
SetVidData(2042,VID_RELOAD_TIME,15);
SetVidData(2043,VID_BATTLERANGE,850);
