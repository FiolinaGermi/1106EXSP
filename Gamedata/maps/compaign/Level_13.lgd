OnGetExperience( int iHeroId, int iExp ) {return 0; }
GetHeroColor( int iColor, int iArmy, int iInd ) {return 0; }
GetAddonSkillFormulaForHero( int id, int skill_num ) {return 0; }
GetAddonSkillFormulaForWeapon( int id, int parent_id, int skill_num ) {return 0; }
GetAddonSkillFormulaForArmor( int id, int parent_id, int skill_num ) {return 0; }

