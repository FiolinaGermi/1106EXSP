//
#ifndef CreateSprite
	#include "Gamedata\scripts\core\export.lgc"
#endif

#ifndef COMMON_DEFS_H
	#include "Gamedata\scripts\common\common_defs.lgc"
#endif

#define FOR_PUBLISHERS true
#define NO_NAG         3    // количество на?скрино?
#define NAG_DELAY      4100 // время на просмотр одно?картинки,  ?ms


int    StartPicture = 0;// время начала показа картинки
int    NoPicture    = 0;// номе?показываемой картинки
int    Picture      = 0;// ссылка на саму показываемую ?данный момент картинку
string NextMap      = "";
int    MaxPicture;// количество на?скрино?
int    MenuLoadFlag = 0;// 1 если меню уж?загружен?
int    KeyPressed = 0;// была нажата какая либо кнопка


//------------------------------------------------------------------------------------------
main()
{
	iff( 1 )
	{
		//SetMapTypeEx( MAP_TYPE_UNKNOWN, "" );
		if( FOR_PUBLISHERS )
			SetCursor( CURSOR_OFF );
		else
			SetCursor( CURSOR_NORMAL );
		StartPicture = GetTime();
		//Effect(EFF_FADE_OUT,0);
        MaxPicture = NO_NAG;//GetVidData(2208, VID_NO_DIR);
	}

	//
    if ( GetEffectState(EFF_FADE) > 45 )
    {
    	//уходим ?nag-скрина
		if( NextMap=="exit" )
		{
			int ToMainMenu = GetGlobValI("GoToMainMenuAfterSlide", 0 );
			SetGlobValI("GoToMainMenuAfterSlide", 0 );
			if( ToMainMenu )
			{
				MenuRelease();//zmnew 2005Apr28 - wit said do this to delete "loading" sprite
				Load( "Gamedata\\maps\\mainmenu.map" );
			}
			else
				Load( "Gamedata\\maps\\mainmenu.map" );
		}
    }
	if( GetEffectState(EFF_FADE) > 45 || GetEffectState(EFF_FADE_OUT) > 45 || GetEffectState(EFF_ALPHAAPPEAR) > 45 )
	{
  		if(Picture)
  		{
  			if( NoPicture >= MaxPicture )
  				NoPicture = 0;
  			int dir = SendCommand( EXT_GETABSDIR, GetVid(Picture), NoPicture );
  			Action( Picture, ACT_CHANGE_DIRECTION, dir );
  			//Log2("aaa - " + itoa(NoPicture) + " - " + itoa(dir));
  		}

  		//грузим менюшк?разо?
  		iff( 1 )
  		{
/*				MenuLoad( "Gamedata\\men\\nag.men" );
  			if( FOR_PUBLISHERS )
  			{
  				Destroy( MenuFindNamed( "TESTERS_MM" ) );
  				Destroy( MenuFindNamed( "TESTERS_EXIT" ) );
  				Destroy( MenuFindNamed( "TESTERS_REPORT" ) );
  				Destroy( MenuFindNamed( "Testers_Report" ) );
  				Destroy( MenuFindNamed( "Testers_MainMenu" ) );
  				Destroy( MenuFindNamed( "Testers_Exit" ) );
  			}
  			Picture = Create();//MenuFind(2208);*/
  			NoPicture = 0;
            //if ( ScreenX() == 800 )
      			Picture = CreateSprite(2208, ScreenX()/2, ScreenY()/2, 0);
            //else
      		//	Picture = CreateSprite(2252, ScreenX()/2, ScreenY()/2, 0);
//              if ( ScreenX() == 800 )
//                  Action(Picture, ACT_SET_SCALE, 800000 / 1024, 800000 / 1024, 1000);
  		}
	}

   	int btn;
   	if( btn = MenuLClick() )
   	{
   		if( btn == MenuFindNamed( "TESTERS_MM" ) )
   		{
   			SetGlobValI("GoToMainMenuAfterSlide", 1 );
  			Effect(EFF_ALPHAAPPEAR,0, 0, 0);
   			Effect(EFF_FADE,0, 0, 1000);
    		StartPicture = GetTime();
   			Load( "Gamedata\\maps\\mainmenu.map" );
            return;
   		}
   		else
   		if( btn == MenuFindNamed( "TESTERS_EXIT" ) )
   		{
   			SetGlobValI("GoToMainMenuAfterSlide", 0 );
  			Effect(EFF_ALPHAAPPEAR,0, 0, 0);
   			Effect(EFF_FADE,0, 0, 1000);
    		StartPicture = GetTime();
   			NextMap = "exit";
            return;
   		}
   		else
   		if( btn == MenuFindNamed( "TESTERS_REPORT" ) )
   		{
   			Exec( GetString( "menu", "Testers_URL") );
   			Load( "Gamedata\\maps\\mainmenu.map" );
   			//
   			//SetRe( GetDefaultRegPat(), "GoToMainMenuAfterSlide", 0 );
   			//Effect(EFF_FADE,0);
   			//NextMap = "exit";
   		}
   		else
   		if( btn == MenuFindNamed( "Nag_Buy_Btn" ) )
   		{
//   			Exec("buynow.html");
            Exec(GetString("strings","BuyLink"));
   			Load( "Gamedata\\maps\\mainmenu.map" );
   		}
   	}

    if ( !MenuLoadFlag && NoPicture == MaxPicture - 1 )
    {
        StartPicture += 7000;
        MenuLoadFlag = 1;
        //if ( ScreenX() == 800 )
            MenuLoad( "Gamedata\\men\\nag.men" );
        //else
        //    MenuLoad( "Gamedata\\men\\nag1024.men");
        if ( GetGlobValI("GoToMainMenuAfterSlide", 0 ) )
        {
            Destroy(MenuFindNamed( "TESTERS_EXIT" ));
            Destroy(MenuFindNamed( "Testers_Exit" ));
        }
        else
        {
            Destroy(MenuFindNamed( "TESTERS_MM" ));
            Destroy(MenuFindNamed( "Testers_MainMenu" ));
        }
		SetCursor( CURSOR_NORMAL );
    }
	//кртинк?уж?показана - обрабатываем клик?
	if( GetEffectState(EFF_FADE) < 0 && GetEffectState(EFF_ALPHAAPPEAR) < 0 )
	{
		if ( (GetTime() - StartPicture) > NAG_DELAY )
		{
			StartPicture = GetTime();
  			Effect(EFF_ALPHAAPPEAR,0, 0, 1500);
			NoPicture++;
		}
  		else
		{
			if ( MenuLoadFlag && GetKey() == VK_ESCAPE )
			{
       			Effect(EFF_FADE,0, 0, 1000);
				Load( "Gamedata\\maps\\mainmenu.map" );
			}
			else if ( KeyPressed )
            {
                KeyPressed = 0;
				StartPicture = GetTime() + NAG_DELAY + 900;
				Effect(EFF_ALPHAAPPEAR,0, 0, 1500);
				NoPicture++;
			}
		}
	}
    if( GetInputAction(IA_ANY_KEY) )
        KeyPressed = 1;
}

