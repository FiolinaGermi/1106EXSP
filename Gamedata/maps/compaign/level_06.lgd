main()
{
if (GetCurResolution() == 11) {
    // 2k（2560x1440） 数值
    SetVidData(2088,VID_BATTLERANGE,580);
    SetVidData(2090,VID_BATTLERANGE,580);
    SetVidData(2092,VID_BATTLERANGE,640);
    SetVidData(2380,VID_BATTLERANGE,480);
    SetVidData(2380,VID_AIM_RADIUS,10);

    SetVidData(2390,VID_BATTLERANGE,640);
    SetVidData(2390,VID_AIM_RADIUS,10);

    SetVidData(2404,VID_BATTLERANGE,580);
    SetVidData(2404,VID_AIM_RADIUS,10);

    SetVidData(2416,VID_BATTLERANGE,580);
    SetVidData(2416,VID_AIM_RADIUS,10);

    SetVidData(2430,VID_BATTLERANGE,580);
    SetVidData(2430,VID_AIM_RADIUS,10);

    SetVidData(1840,VID_BATTLERANGE,580);
    SetVidData(1840,VID_AIM_RADIUS,10);
} else {
    SetVidData(2088,VID_BATTLERANGE,430);
    SetVidData(2090,VID_BATTLERANGE,430);
    SetVidData(2092,VID_BATTLERANGE,490);

    SetVidData(2390,VID_BATTLERANGE,490);
    SetVidData(2390,VID_AIM_RADIUS,10);

    SetVidData(2404,VID_BATTLERANGE,430);
    SetVidData(2404,VID_AIM_RADIUS,10);

    SetVidData(2416,VID_BATTLERANGE,430);
    SetVidData(2416,VID_AIM_RADIUS,10);

    SetVidData(2430,VID_BATTLERANGE,430);
    SetVidData(2430,VID_AIM_RADIUS,10);

    SetVidData(1840,VID_BATTLERANGE,430);
    SetVidData(1840,VID_AIM_RADIUS,10);
}


 iff(1)
  {
    SetMapTypeEx( MAP_TYPE_LEVEL, "Level_01" );
	//SetScrollBoxEx( 0 );
    InitGame();
  // 初始化传送系统 想在哪关使用就加这一天
    
  // 例如：输入K Z L (就是卡住了)
    
  //玩家会自我伤害15点，然后传送到鼠标距离-10单位的距离
    
  //InitTeleportSystem();      
  }
  if( GameTact() )
    return;

  QuestsTact();
  CompaignGameTact();
  // 更新传送系统
  UpdateTeleportSystem();
 
  //iff( SizeTo(Flagman(0),2301,362) < 70 )
  //{                               
    //Win();
