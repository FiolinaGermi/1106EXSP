#define SECRET_KEY_LENGTH 3
static int secret_keys[SECRET_KEY_LENGTH];
static int last_key_time=0;
static int teleport_uses=0;
#define MAX_TELEPORT_USES 3

// 传送到鼠标方向15个单位距离
TeleportToMouseDirection()
{
  int player = Flagman(0);
  if(player)
  {
    // 检查使用次数
    if(teleport_uses >= MAX_TELEPORT_USES)
    {
      return;
    }
    
    // 自我伤害15点
    Action(player, ACT_DAMAGE, 10);
    
    // 增加使用次数
    teleport_uses++;
    
    // 获取鼠标位置
    int mouse_x = GetInputAction(IA_MOUSE_X);
    int mouse_y = GetInputAction(IA_MOUSE_Y);
    
    // 获取玩家位置
    int player_x = GetX(player);
    int player_y = GetY(player);
    
    // 计算鼠标方向的单位向量
    int dx = mouse_x - player_x;
    int dy = mouse_y - player_y;
    int distance = SizeTo(player, mouse_x, mouse_y);
    
    if(distance > 0)
    {
      // 计算10个单位距离的新位置
      int new_x = player_x + (dx * 15) / distance;
      int new_y = player_y + (dy * 15) / distance;
      int new_z = GetGroundZ(new_x, new_y);
      
      // 创建新的玩家单位
      int new_player = CreateSprite(GetVid(player), new_x, new_y, new_z);
      if(new_player)
      {
        // 销毁旧玩家单位
        Destroy(player);
        // 设置新单位为玩家控制
        Action(new_player, ACT_SET_ARMY, 0);
        SetFlagman(0, new_player);
        
        // 播放传送音效
        
      }
    }
  }
}

CheckSecretCode()
{
  // 检测按键
  int key=GetKey();
  if(key && GetTime()-last_key_time>300)
  {
    last_key_time=GetTime();
    
    // 记录按键历史
    int i;
    for(i=0; i<SECRET_KEY_LENGTH-1; i++)
    {
      secret_keys[i]=secret_keys[i+1];
    }
    secret_keys[SECRET_KEY_LENGTH-1]=key;
    
    // 检查是否输入了"KZL"（我卡住了）
    if((secret_keys[0]=='K' || secret_keys[0]=='k') && (secret_keys[1]=='Z' || secret_keys[1]=='z') && (secret_keys[2]=='L' || secret_keys[2]=='l'))
    {
      // 触发传送动作
      TeleportToMouseDirection();
    }
  }
}

InitTeleportSystem()
{
  // 初始化按键数组
  for(int i = 0; i < SECRET_KEY_LENGTH; i++)
  {
    secret_keys[i] = 0;
  }
  teleport_uses = 0;
}

UpdateTeleportSystem()
{
  // 检测传送密码
  CheckSecretCode();
}
