//------------------------------------------------------------------------------------
IsBoxVid( int iVid )
{
    int ret = 0;
    if( iVid == 1270 || iVid == 1272 || iVid == 1274 || iVid == 1276 || iVid == 1225 
        || iVid == 1768 || iVid == 1259 || iVid == 2332 )
    {
        ret = 1;
    }
    return ret;
}


//---------------------------------------------------------------------------------
AddBonusIfNeeded(int unit)
{
    int buf = SendCommand( EXT_GETRANDBONUSID, GetVid( unit ) );
    if( !buf || !unit )
        return;

    //LogToConsole( "Add bonus to monster (campaign) " + itoa( buf ) );
    Action( unit, ACT_ADD_ITEM, buf );
}


//---------------------------------------------------------------------------------
SetRandomScale(int unit)
{
    //if( !SendCommand( EXT_GETSURVIVEMODE ) )
    //  return;

    //
    int MinScale = GetMinScale( GetVid(unit) ) * 10;
    int MaxScale = GetMaxScale( GetVid(unit) ) * 10;
    //
    int CurScale = Action( unit, ACT_GET_SCALE, 0 );
    if( CurScale == 1000 )  //if scale is not set in map editor
    {
        //change monster sizes from MinScale% to MaxScale%
        CurScale = MinScale + Random( MaxScale - MinScale, 1009 );

        //get current gamma
        int r = Action( unit, ACT_GET_GAMMA, 1 );
        int g = Action( unit, ACT_GET_GAMMA, 2 );
        int b = Action( unit, ACT_GET_GAMMA, 3 );

        //change monster color
        if( CurScale > 1000 )
        {
            r += ( CurScale - 1000 ) * INC_RED_ON_MAX   / ( MaxScale - 1000 );
            g += ( CurScale - 1000 ) * INC_GREEN_ON_MAX / ( MaxScale - 1000 );
            b += ( CurScale - 1000 ) * INC_BLUE_ON_MAX  / ( MaxScale - 1000 );
        }
        else
        if( CurScale < 1000 )
        {
            r += ( 1000 - CurScale ) * INC_RED_ON_MIN   / ( 1000 - MinScale);
            g += ( 1000 - CurScale ) * INC_GREEN_ON_MIN / ( 1000 - MinScale);
            b += ( 1000 - CurScale ) * INC_BLUE_ON_MIN  / ( 1000 - MinScale);
        }
        //set new gama
        int gamma = GammaEncodeToDword( r, g, b );
        //LogToConsole( "New Gamma - " + itoa(r) + "-" +itoa(g) + "-" +itoa(b)  );
        Action( unit, ACT_SET_GAMMA, gamma );
    }
    //
    MonsterScale( unit, CurScale, true, MinScale );
}
//zs2
On3958Death(int unit);

//������ ���� - ����?������
On3958Death(int unit)
{
	if(!unit)
		return;
	//
	int x = GetX(unit);
	int y = GetY(unit);
	int z = GetZ(unit);
	//
	int spr1 = 0;
	int spr2 = 0;
	spr1 = FindNearestSprite(GETSPRITE_VID(3316), x, y, 100);
	if(SizeTo(spr1, x ,y) > 85)
		spr1 = 0;
	if(spr1)
	{
		spr2 = GetSprite(GETSPRITE_VID(3318), GetX(spr1), GetY(spr1));
		if(!spr2)
		spr2 = FindNearestSprite(GETSPRITE_VID(3318), x, y, 100);
		if(SizeTo(spr2, x ,y) > 85)
			spr2 = 0;
	}
	//
	//Log2("spr1 = " + itoa(spr1) + ". spr2 = " + itoa(spr2));
	//
	if(spr1 && spr2)
	{
		int anim = GetAnimation(spr2);
		if(anim != ANI_DEATH && anim != ANI_DEATH2)
		{
			Destroy(spr1);
			Destroy(spr2);
		}
	}
}
