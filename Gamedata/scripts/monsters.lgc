//����?tank (?���� P_Track)
 F2031_8(int unit)
{
	int inc_dir  = 128/GetVidData(2031,VID_NO_DIR);
	int n_dir    = (((GetDirection(unit) + inc_dir)&255)*GetVidData(2031,VID_NO_DIR))/256;
	int beg_cadr = GetVidData(2031,VID_NO_DIR) * (32 + 1) + n_dir * 31;
//Log("4060 "+itoa(beg_cadr)+"/"+itoa(SendCommand(EXT_GETCURCADR,unit)));
	if ( (SendCommand(EXT_GETCURCADR,unit)-beg_cadr)==20 )
	{
		int goal = Action(unit, ACT_GET_GOAL);
//Log(itoa(beg_cadr)+" "+itoa(goal));
		int spr  = CreateSprite(2037, GetX(unit), GetY(unit), GetZ(unit) + 30, GetDirection(unit), unit);
		if ( goal )
//			Action(spr, ACT_ATTACK, goal);//ACT_MOVE, 10, 10, 30);//goal);// ATTACK
			Action(spr, ACT_MOVE_TO, goal);//goal);// ATTACK
		EarthQuake(400);
	}
}

