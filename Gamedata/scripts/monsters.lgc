//---------------------------------------------------------------------------------
Common_Born(int unit, int parent)
{
    SetRandomScale(unit);
    //
    //zmNEW2006Mar22 - ��?�������� �� ����������?����������? ��������� ?��������?
    if(parent && Action(parent, ACT_HAVE_ITEM, -666) || SendCommand( EXT_GETSURVIVEMODE ))
    {
        InitStatData[ VSTAT_MMONSTERSCNT ]++;
    }
}


//---------------------------------------------------------------------------------
// ���������� ����?�� ������ ����
AddScores(int unit)
{
	#ifdef Z_GUN_STAND
	if(g_bGS_KillAllMonst)
		return;
	#endif
	//
    int MonstArmy = Action(unit, ACT_GET_ARMY);
    //
    int KillerArmy = Action(unit, ACT_GET_KILLER_ARMY);
    //Log2("KILLER_ARMY - " + itoa(KillerArmy));
	//
	SendCommandA( KillerArmy, EXT_ADDSKILL, RPGHERO_KILLS, 1 );
    //
    bool bExplKill = IsMonstExplodeKillVid( GetVid( unit ) ) && GetAnimation( unit ) != ANI_DEATH;
    //don't count rats and boxes. ����?�� ��������?�������� 6-�� ����?
    if( IsMonsterVid( GetVid( unit ) ) || bExplKill )
    {
        if( Action(unit, ACT_GET_ARMY) == 6 )
        {
            //�������� 6-�� ����?��������� ������ ���� ��?����?������?
            if( KillerArmy == 0 )
            {
                CurStatData[ VSTAT_MMONSTERSKILLED ]++;
                InitStatData[ VSTAT_MMONSTERSCNT ]++;
            }
        }
        else
        {
            CurStatData[ VSTAT_MMONSTERSKILLED ]++;
            //zmTEMPaaa: for debug
            /**/int i;
            for( i = 0; i < sizeof( MonstersVid ) / sizeof( int ); i++ )
            {
                if( GetVid( unit ) == MonstersVid[ i ] )
                {
                    DebugKilledMonstersByVid[ i ]++;
                    //zmTEMPaaa
                    //Log2("VSTAT_killed:" + itoa(GetX(unit)) + "-" + itoa(GetY(unit)) + "-" + itoa(GetZ(unit)) );
                }
            }//*/
        }
    }
   
    //bool MustAdd = true;

    //������ ������ �����:
    //  1) ?survive ��������� exp ������
    //  2) ?campaign ��������� exp ������ ����?�������� ������ �������������������� ��������?
    //*zm060711 - ������ ��?�� ������ ��?

  #ifndef NET_GAME_RUN
    if( !SendCommand(EXT_GETSURVIVEMODE) && KillerArmy != 0 && MonstArmy != 4 )
        return;
  #endif
  #ifdef NET_GAME_RUN
    if( !NetProperty( NET_IS_PLAYER_EXIST + KillerArmy ) )
        return;
  #endif

	//if(MustAdd)
	//{
	    int MaxHp = GetVidData(GetVid(unit),VID_MAXHP);

	    //zm2006Jan30 - ������ ��������� �� ������
    	//if( Action(unit,ACT_GET_ARMY) == 4 )//�� ��������� exp �� ������������������?��������
	    //    MaxHp = 0;
	    //
	    OnEnemyKill( KillerArmy, MaxHp );
	//}
}


//---------------------------------------------------------------------------------
//return true if kill of unit adds exp to hero
MustAddExpForKill( int unit )
{
    int ret;
    ret = false;
    //
    int Army;
    Army = Action( unit, ACT_GET_ARMY );

    //LogToConsole( itoa( GetVidData( GetVid( unit ), VID_SPRITETYPE ) ) );

    if( Army == 1 || Army == 4 || Army == 6 )
    {
        //add points for kill of all entities of the 1st army (enemies)
        ret = true;
    }
    else
    if( ( Army == 2 || Army == 3 ) && ( GetVidData( GetVid( unit ), VID_SPRITETYPE ) == U_UNIT ) )
    {
        //add points for kill of only monsters of 2nd (neutrals, such as rats) and 3rd army (soldiers)
        ret = true;
    }

    return ret;
}


//---------------------------------------------------------------------------------
// ��?������ ����?�������� ��?����������?
CreateItems( int unit, int delay = 0 )
{
	//����?��������, ������ ���� ?����?������!  *zm060704
	//冻结状态下跳过第二阶段变形，直接死亡
	bool Freezed = HaveLink( unit, SURVIVE_FREEZE_EFFECT ) || Action(unit, ACT_HAVE_ITEM, -666);
	if(Freezed)
		Action( unit, ACT_DELETE_ITEM, -666 );
	//
	int KillerrArmy = Action( unit, ACT_GET_KILLER_ARMY );
	if(Flagman(KillerrArmy) && !Freezed)
	{
	    //*zm2006Mar28. ��������? ����?���� ������
	    //������?�������� CurWeaponExpl
		//-1 -�� ��?��, 0 - ������ ��������?ANI_DEATH2, �� 1 �� 100 - ����������� ��������� ANI_DEATH2
		int expl = CurWeaponExpl[KillerrArmy];
		if(expl != -1)	//-1 -�� ��?��
		{
			//������ �������� ������, ����?�� ���� ���������������� ��?������ ������?violence
			int rand = 0;
			if(expl != 0)
				rand = 1+Random(99, 1094); //1..100
			//
			if(expl == 0 || VM_TURNOFF_DEATH2[GetRealViolenceMode()])	//0 - ������ ��������?ANI_DEATH2
			{
				if(GetAnimation(unit) == ANI_DEATH2)
		        {
    		        Action(unit, ANI_DEATH);
        		    return;
		        }
			}
			else
			if(expl != 0)
	        {
				if(GetAnimation(unit) == ANI_DEATH && expl >= rand)
		        {	
		        	//*zm2006Aug02
		        	if(GetVidData(GetVid(unit), VID_CHILD + ANI_DEATH2))
		        	{
	    		        Action(unit, ANI_DEATH2);
    	    		    return;
					}
		        }
	        }
		}
	}
	bool bWasBoss = false;
    if(Action(unit, ACT_HAVE_ITEM, -777))
    {
        Action( unit, ACT_DELETE_ITEM, -777 );//������� ����?��?����
        SetBossEnvGamma(false);
        bWasBoss = true;
        Log2("Boss killed. vid = " + itoa(GetVid(unit)));
	}

    //������������?������?������
    BloodToCars(unit);

    //���������� ����?�� ������ ����
    if( MustAddExpForKill( unit ) )
    {
        AddScores(unit);
        giLastMonsterKillTime = GetTime();
    }

    //������� ������?�� ������ ��������������?
    if( Action( unit, ACT_HAVE_ITEM, -555 ) )
        DeleteHypnMonster(unit);

    //add bonuses in campaign mode
    if( !SendCommand( EXT_GETSURVIVEMODE ) )
    {
        //remove all items, invalid items can exist (saved in mapedit) (from old version of AS)
        if( !IsBoxVid( GetVid(unit) ) )
            Action( unit, ACT_DELETE_ALL_ITEM );
        AddBonusIfNeeded(unit);
    }
    //
    //�������� ����?�� ������?
    int no_items;
    no_items = Action(unit,ACT_NO_ITEMS);
    if( no_items )
    {
        int z = 5;
        if( IsBoxVid( GetVid(unit) ) )
            z = Z_FOR_BORN_FROM_BOXES;// ������������ �������� ��� ������?�����?

        int ItemId;
        int ItemVid = 0;
        ItemId = Action(unit,ACT_GET_ITEM,Random(no_items-1, 1010),0 );

        //����?��?Bonus_cur_ammo - ������������ Id (��?��?��-������)
        int karmy = KillerrArmy;
        if(!Flagman(karmy))
        	karmy = 0;
        ItemId = SendCommandA( karmy, EXT_GETITEMVIDBYID, ItemId, 3 );
        //
        if(ItemId != 0) //������ ����?��?��������
            ItemVid = SendCommandA( -1, EXT_GETITEMVIDBYID, ItemId );
		//
	#ifdef NET_GAME_RUN
		//?����?�� ���������� ��������?����?������
		if(ItemVid>=1683 && ItemVid<=1689)
			ItemVid = 0;
		//����?�� ���������� ����?
		if(ItemVid==1653)
			ItemVid = 0;
	#endif

        //�� ���� ������?������ Jeep ���� �� ����?��?���� SURVIVE_JEEP_VID, 1208 ��?����?Jeep
        if( ItemVid != 1686 || (!GetVidData( SURVIVE_JEEP_VID, VID_EXIST ) || !GetVidData( SURVIVE_JEEP_VID, VID_COUNT ) )
            && ( !GetVidData( 1208, VID_EXIST ) || !GetVidData( 1208, VID_COUNT ) )
            && ( !GetVidData( 1686, VID_EXIST ) || !GetVidData( 1686, VID_COUNT ) ) )
        {
            if( ItemVid != 0 )
            {
    	    	int jj, item;
    	    	int cnt = 1;
	            if(bWasBoss)
	            {
	            	cnt = NetPlCnt;
	            	Log2("bWasBoss, cnt == " + itoa(cnt) + ", vid = " + itoa(ItemVid));
				}
				for(jj = 0; jj < cnt; jj++)
				{
	                item = CreateSprite( ItemVid, GetX(unit), GetY(unit), GetZ(unit)+z, GetDirection(unit) );
    	            Action( item, ACT_SET_OBJECT_ID, ItemId );
					//
					//if(Z_DEBUG)
					//	Action( item, ACT_SET_DEATH_TIMER, 1000000 );
					//
    	            if ( delay )
        	        {
            	        Action(item, ANI_SALUT);
                	    Action(item, ACT_PAUSE, delay);
	                }
				}
            }
        }
    }
    //
    if(Freezed)
    {
        Destroy(unit);
        return 1;
    }
}

#include "gamedata\scripts\monsters_rats.lgc"

CommonCreateEffect(int unit, int parent)
{
    if ( GetVid(parent) == 1250 )//��� ��������?����������
    {
        CreateSprite(1390, GetX(unit), GetY(unit) + 40, GetZ(unit) + 40);
    }
}
