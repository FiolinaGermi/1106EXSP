F1060_14(int unit, int parent)
{
    if ( GetVid(parent)==1066 )
    {
        if ( GetDirection(parent) <= 128 )
            Action(unit, ACT_CHANGE_DIRECTION, 96 + 64);
        else
            Action(unit, ACT_CHANGE_DIRECTION, 96);
    }
    else
        Common_Born(unit,parent);
}
