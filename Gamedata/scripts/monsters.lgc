//------------------------------------------------------------------------------------------
//��� ����? ����, ����?�� ����? ���������� ������? ���������� ����.
//      �� ������ ����������?����?�������� ����?������ (����?��� ����?����)
Barrel_Damage( int iUnit, int iBeatingUnit, int iDamage )
{
    int Army = 0;
    if(iBeatingUnit)
        Army = Action(iBeatingUnit, ACT_GET_ARMY);
    //
    if( !iBeatingUnit || !Flagman(Army) )   //���� ���������� ����?����?����?
        return 0;
    //
    int NewHp = Action( iUnit, ACT_GET_HP ) - iDamage;
    if( NewHp <= 0 )
        Action(iUnit, ACT_SET_ARMY, Army);
    //
    //Log2("Army - " + itoa(Army) + ". NewHp - " + itoa(NewHp));
    //
    return 0;
}
