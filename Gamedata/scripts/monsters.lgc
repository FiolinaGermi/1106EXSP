//##########################################################################################################
// ���� �� ������?������ �� ������ ������ ���������� ������ ����������
F1066_COLLISION(int unit,int crushed_unit)
{
    int x = GetX(crushed_unit);
    int y = GetY(crushed_unit);
    int z = GetZ(crushed_unit);
    int dir;// = GetDirection(unit);
    int delit = 64;
    int count;
    do
    {
        count = 30;
        delit = (delit * 2) / 3;
        do
        {
            dir = Random(255, 31);
        }
        while ( --count > 0 && CanPlace(GetVid(crushed_unit), x + Sin(dir) / delit, y - Cos(dir) / delit, z) );
Log("collision "+itoa(GetVid(unit)) + " "+itoa(GetVid(crushed_unit)) + " "+itoa(count) + " "+itoa(dir));
    }
    while ( count <= 0 && delit > 12 );
Log("last collision "+itoa(GetVid(unit)) + " "+itoa(GetVid(crushed_unit)) + " "+itoa(count) + " "+itoa(dir));
    if ( count > 0 )
        Action(crushed_unit, ACT_CHANGE_COOR, x + Sin(dir) / delit, y - Cos(dir) / delit, z);
}
//##########################################################################################################
// ��?������ �������� ��������?������ ��?������ ������? ?���������� �������� ��?
F1250_9(int unit)
{
    if ( !Action(unit, ACT_HAVE_ITEM, -1) )
    {
        CreateSprite(1255, GetX(unit), GetY(unit), GetZ(unit) + 1, GetDirection(unit));
        Action(unit, ACT_ADD_ITEM, -1);
        int flagman = Flagman(0);
        if ( Abs(GetX(flagman) - GetX(unit)) < (GetVidData(GetVid(flagman), VID_SIZE_X) + GetVidData(GetVid(unit), VID_SIZE_X) + 2)
            && Abs(GetY(flagman) - GetY(unit)) < (GetVidData(GetVid(flagman), VID_SIZE_Y) + GetVidData(GetVid(unit), VID_SIZE_Y) + 2) )
            {
                int x = GetX(flagman);
                int y = GetY(flagman);
                int z = GetZ(flagman);
                int dir;// = GetDirection(unit);
                int delit = 64;
                int count;
                do
                {
                    count = 30;
                    delit = (delit * 2) / 3;
                    do
                    {
                        dir = Random(255, 31);
                    }
                    while ( --count > 0 && CanPlace(GetVid(flagman), x + Sin(dir) / delit, y - Cos(dir) / delit, z) );
            Log("collision teleport "+itoa(GetVid(unit)) + " "+itoa(GetVid(flagman)) + " "+itoa(count) + " "+itoa(dir));
                }
                while ( count <= 0 && delit > 12 );
            Log("last collision teleport "+itoa(GetVid(unit)) + " "+itoa(GetVid(flagman)) + " "+itoa(count) + " "+itoa(dir));
                if ( count > 0 )
                    Action(flagman, ACT_CHANGE_COOR, x + Sin(dir) / delit, y - Cos(dir) / delit, z);
            }
/*        for ( int spr = FirstInBox(GetX(unit) - 80, GetY(unit) - 80, GetX(unit) + 80, GetY(unit) + 80);
              spr;
              spr = NextInBox() )
            if ( GetVidData(GetVid(spr), VID_CLASS) == B_MAN )*/
    }
}
F1250_COLLISION(int unit,int crushed_unit)
{
    int x = GetX(crushed_unit);
    int y = GetY(crushed_unit);
    int z = GetZ(crushed_unit);
    int dir = DirectionTo(unit, GetX(crushed_unit), GetY(crushed_unit));
    Action(crushed_unit, ACT_CHANGE_COOR, x + Sin(dir) / 32, y - Cos(dir) / 32, z);
}

//------------------------------------------------------------------------------------------
//PERF: continuous stream weapons (flamethrower/freeze gun) deal damage every frame
//while their particles overlap a monster. The per-tick IsMonsterVid() linear scan in
//Common_Damage is a major CPU cost for such weapons, so statistics skip these bullets.
IsStreamDamageBullet( int iBeatingUnit )
{
    if( !iBeatingUnit )
        return 0;
    int bvid = GetVid( iBeatingUnit );
    if( bvid == NVID_FLAMETHROWER_BULLET  || bvid == NVID_FLAMETHROWER_BULLET2
     || bvid == NVID_BURNER_BULLET        || bvid == NVID_BURNER_BULLET2
     || bvid == NVID_FREEZEWPN_BULLET     || bvid == NVID_FREEZEWPN_BULLET2 )
        return 1;
    return 0;
}


//------------------------------------------------------------------------------------------
Common_Damage( int iUnit, int iBeatingUnit, int iDamage )
{
    int ret = 0;
    //
    int vid = GetVid(iUnit);
	//
    if ( vid == 1070 )
    {// �������� ?�������� ����?��?�������� ����������?������ ��??��������
        if ( GetAnimation(iUnit) != ANI_STAND_OPEN )
        {
            iDamage /= 10;
            if ( !iDamage )
                iDamage = 1;
        }
        ret = 1;
        Action(iUnit, ACT_SET_HP, Action(iUnit, ACT_GET_HP) - iDamage);
        //1070也支持冰冻枪冻结
        ret |= FreezeDamage( iUnit, iBeatingUnit, iDamage );
    }

    if(vid != 1070)	//�������� ��?
    {
    	//������ ?��������?�� ��������??�� ������?
    	if(vid != 1890 && vid != 1895 && vid != 1901 && vid != 1080 && vid != 1087 )
    	{
	        ret |= ReducingDamage( iUnit, iBeatingUnit, iDamage );
	        ret |= FreezeDamage( iUnit, iBeatingUnit, iDamage );
		}
        //
        ret |= BurningDamage( iUnit, iBeatingUnit, iDamage );
    }

    //
#ifndef NET_GAME_RUN
    //PERF: skip the IsMonsterVid() linear scan for flame/freeze stream bullets
    //(they generate hundreds of damage ticks per frame; stats are unaffected)
    if( !ret && !IsStreamDamageBullet(iBeatingUnit) && IsMonsterVid(vid) )
    {
        static int LastTime = 0;
        if( LastTime != GetTime() )
        {
            CurStatData[ VSTAT_MACCURACY_NUM ] += iDamage;
            LastTime = GetTime();
        }
    }
#endif

//zmNEW2006Jun28
#ifdef NET_GAME_RUN
	if(!ret && iBeatingUnit)
	{
	    int ExpToAdd = iDamage;
	    int hp = Action(iUnit, ACT_GET_HP);
	    if(ExpToAdd > hp)
	    	ExpToAdd = hp;
	    ExpToAdd = ExpToAdd * giScoresCoeff;
    	SendCommandA( Action(iBeatingUnit, ACT_GET_ARMY), EXT_ADDSKILL, RPGHERO_EXP, ExpToAdd );
	}
#endif

    //
    return ret;
}


