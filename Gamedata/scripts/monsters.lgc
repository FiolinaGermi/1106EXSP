#define Z_FOR_BORN_FROM_BOXES   8

static int s_aRandZombies[] = {3800, 3950, 3976, 3805, 3984, 3988, 3972, 3980, 3954};

RandomizeZombie(int unit)
{
	int cnt = sizeof(s_aRandZombies)/4;
	int r = Random_(cnt-1);
	if( GetVidData(s_aRandZombies[r], VID_EXIST))
		Action(unit, ACT_CHANGE_VID, s_aRandZombies[r]);
}


