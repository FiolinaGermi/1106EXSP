		}

		TactOptionsMenu();
		int btn = MenuLClick();
		if( btn && MenuNVidUnderCursor() == 705 )
		{
			if( btn == MenuFindNamed( "GOTO_GAME" ) )
				ChangeMenuStateSH( MENU_SHOP );
			else
			if( btn == MenuFindNamed( "GOTO_MAINMENU" ) )
				GoToMainMenu();
		}
		if( GetKey() == VK_ESCAPE )
			ChangeMenuStateSH( MENU_SHOP );*/
	}
	else
	if( MenuState == MENU_PLAY )
	{
		if( ( GetTime() - StartEffectTime) > FADE_GAME_TIME/2 || giMapType == MAP_TYPE_LEVELSHOP )
		{
			// загрузка игрово?карт?
			StartEffectTime = 0;
			if( giMapType != MAP_TYPE_LEVELSHOP )
				StopMusicEx();

			if( giMapType == MAP_TYPE_LEVELSHOP )
				CloseMenuWndAndAssign();//CloseShop();
			else
			{
				CloseShop();
				SetLevelNumber( Z_FIRST_LEVEL_NUM, -1 );
				SendCommandA( -1, EXT_OnLevelWin );
				LoadCurLevel();
				LoadCurNextMap();
			}
		}
	}
	else
	if( MenuState == MENU_MAIN )
	{
		if( ( GetTime() - StartEffectTime ) > FADE_GAME_TIME/2 || giMapType == MAP_TYPE_LEVELSHOP)
		{
			StartEffectTime = 0;
			if( giMapType == MAP_TYPE_LEVELSHOP )
				CloseMenuWndAndAssign();//CloseShop();
			else
			{
				CloseShop();
				MenuRelease();//zmnew 2005Apr28 - wit said do this to delete "loading" sprite
				Load( "gamedata\\maps\\mainmenu.map" );
			}
			MenuState = 0;
		}
	}
}