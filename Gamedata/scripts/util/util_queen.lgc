//------------------------------------------------------------------------------------------
static int BossPrevHp;
static int BossMaxHp;
static int BossPrevPhaseHp = 0;
static int BossHealthBar = 0;
static int BossHealthBarText = 0;
static int Boss = 0;
//
static int StartGammaTime = 0;
static int StartQueenPauseTime = 0;

F1070_0(int unit)
{
	int NearFlagman = FindNearestFlagman( GetX(unit), GetY(unit), 1000 );
	//
    if ( NearFlagman )
    {
        Boss = unit;
        BossMaxHp = GetVidData(GetVid(unit), VID_MAXHP1);
        BossPrevHp = Action( Boss, ACT_GET_HP );
//        SetVidData(1070, VID_MAXHP, 0);
    //    Action(QueenGenerator, ACT_PAUSE, 300000);
        if ( (GetTime() - StartQueenPauseTime) > 20000 )
        {
            Action(unit, ACT_STOP);
            Action(unit, ACT_SET_COMMAND, COM_NONE);
            Action(unit, ACT_SET_BEHAVE, 0);
            Action(unit, ANI_OPEN);
            AddCommand(unit, ANI_STAND_OPEN);
            AddCommand(unit, ANI_STAND_OPEN);
            AddCommand(unit, ANI_STAND_OPEN);
            AddCommand(unit, ANI_STAND_OPEN);
            AddCommand(unit, ANI_STAND_OPEN);
            AddCommand(unit, ANI_STAND_OPEN);
            AddCommand(unit, ANI_STAND_OPEN);
            AddCommand(unit, ANI_LINK);
        }
    }
}
F1070_2(int unit) { F1070_0(unit); }
F1070_11(int unit)
{
//    if ( SizeTo(Flagman(---), GetX(unit), GetY(unit)) < 1000 )
//        SetVidData(1070, VID_MAXHP, 0);
    Action(unit, ACT_SET_BEHAVE, BEH_ACTIVE + BEH_AGGRESSIVE);
    StartQueenPauseTime = GetTime();
//    Action(QueenGenerator, ACT_PAUSE, 300000);
}

