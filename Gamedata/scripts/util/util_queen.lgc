//------------------------------------------------------------------------------------------
SetBossGamma( int iBoss, int iPercent, int BegGamma, int EndGamma )
{
//    Log("SetBossGamma");
    int gamma = CountGamma(BegGamma,EndGamma,iPercent*255/1000);
    Action(iBoss, ACT_SET_GAMMA, gamma);
    Action(Action(iBoss, ACT_GET_LINK), ACT_SET_GAMMA, gamma);
//    SetVidData( GetVid(iBoss), VID_GAMMA+Action(iBoss,ACT_GET_ARMY),
//                                             CountGamma(BegGamma,EndGamma,iPercent*255/1000) );
}


//------------------------------------------------------------------------------------------
BossTact()
{
    //BossHealthBar is released sometimes (after pressing tab)
    if( Boss && !BossHealthBar )
    {
        BossHealthBar = CreateSprite(2245, ScreenX() / 2 , 900, 0, 0 );
        BossHealthBarText = CreateText(8, ScreenX() / 2, 900, 1, "Boss 100%", BEH_CENTER);
        //mod: cache MaxHP once, avoid per-frame GetVidData
        BossMaxHp = GetVidData( GetVid(Boss), VID_MAXHP1 );
    }

    if( BossHealthBar )
    {
        if( Boss )
        {
            int hp = Action( Boss, ACT_GET_HP );
            if( hp != BossPrevHp )
            {
                BossPrevHp = hp;
                StartGammaTime = GetTime();

                //mod: only update UI when HP changes
                if( hp < 0 )
                    hp = 0;
                int val = 0;
                if( hp && BossMaxHp )
                    val = 255 - 255 * hp / BossMaxHp;
                if( val > 250 )     //250 - standard HACK
                    val = 250;
                Action( BossHealthBar, ACT_CHANGE_DIRECTION, val );
                string pctStr = GetString("menu", "Boss") + " " + itoa(hp * 100 / BossMaxHp) + "%";
                Action( BossHealthBarText, ACT_SET_TEXT, &pctStr );
            }
            if( !hp )
            {
                Destroy( BossHealthBar );
                Destroy( BossHealthBarText );
                BossHealthBar = 0; BossHealthBarText = 0;
            }
        }
        else
        {
            Destroy( BossHealthBar );
            Destroy( BossHealthBarText );
            BossHealthBar = 0; BossHealthBarText = 0;
        }
    }

    //
    if( StartGammaTime )
    {
        int iDelta;
        iDelta = GetTime() - StartGammaTime;
        //
        if( iDelta < BOSS_GAMMA_TIME1 )
            SetBossGamma( Boss, iDelta * 1000 / BOSS_GAMMA_TIME1, 0, GammaEncodeToDword(0, -200, -200)/*BOSS_DAMAGE_GAMMA*/ );
        else
        if( iDelta < BOSS_GAMMA_TIME1 + BOSS_GAMMA_TIME2 )
            SetBossGamma( Boss, (iDelta-BOSS_GAMMA_TIME1) * 1000 / BOSS_GAMMA_TIME2, GammaEncodeToDword(0, -200, -200)/*BOSS_DAMAGE_GAMMA*/, 0 );
        else
        {
            StartGammaTime = 0;
            SetBossGamma( Boss, 0, 0, 0 );
        }
            
    }
    //
    //if( GetKey() == 'o' )
    //  StartGammaTime = GetTime(); 
}


